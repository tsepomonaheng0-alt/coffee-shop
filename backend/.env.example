# Copy to .env for local development. NEVER commit the real .env file.

# Port the API listens on (Render sets PORT automatically)
PORT=4000

# Redis connection string. Use a PERSISTENT Redis (AOF enabled / Upstash / Redis Cloud).
#   local:   redis://127.0.0.1:6379
#   hosted:  rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# Staff dashboard login (required in production)
STAFF_USERNAME=BScSM
STAFF_PASSWORD=BscSM@2026

# Long random string used to sign staff tokens (required in production)
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-a-long-random-string

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Time zone used for the "daily summary"
SHOP_TIMEZONE=Africa/Maseru

# Staff session length in hours
TOKEN_TTL_HOURS=12
