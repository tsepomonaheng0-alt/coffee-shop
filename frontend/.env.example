# Copy to .env  (Vite only reads variables that start with VITE_)

# Base URL of the backend API, no trailing slash.
#  - Local development: leave EMPTY (the Vite dev server proxies /api to http://localhost:4000)
#  - Same-origin deployment (Express serves frontend/dist): leave EMPTY
#  - Vercel / Netlify: https://<your-api>.onrender.com
VITE_API_URL=

# Currency label shown before prices
VITE_CURRENCY=M

# Time zone used for "today" on the staff dashboard (should match backend SHOP_TIMEZONE)
VITE_SHOP_TIMEZONE=Africa/Maseru
